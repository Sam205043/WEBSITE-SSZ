rules_version = '2';

/* ==========================================================================
   Soft Skill Zone Institute — Firestore Security Rules
   --------------------------------------------------------------------------
   This file is the ONLY thing standing between your data and the internet.
   The app is 100% client-side, so anyone can open the browser console and
   call Firestore directly — these rules, not the UI, decide what is allowed.

   HOW TO PUBLISH
   Firebase Console -> Firestore Database -> Rules -> paste this file -> Publish

   IMPORTANT — WHY THE FIELD NAMES MATTER
   For a *list* query Firestore does not read the documents first. It checks
   that the query itself can only ever return documents the rule allows. So a
   rule must reference exactly the same field the app filters on:

     app:  where("isApproved", "==", true)
     rule: resource.data.isApproved == true      <- must match, or it is denied

   Every rule below is written against the actual queries in js/ — if you
   change a query, change the matching rule too.

   MODEL
   - users/{uid}          one doc per login, holds `role`
   - admin               can read and write everything
   - student             can read their own rows and the shared study material
   - visitor (no login)  can read published public content, submit an
                         admission or an enquiry, verify a certificate
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- helpers */
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /* Admin par bhi `status` ki jaanch — pehle sirf `role` dekha jaata tha.

       `users/{uid}.status == 'blocked'` par app khud sign-out kar deta hai
       (firebase/auth-service.js), par wo sirf browser ka pehra hai. Rules me
       koi jaanch nahi thi, isliye block kiya hua admin account console se
       seedhe Firestore par sab kuch padh-likh sakta tha — students, fees,
       admissions, sab. Yaani admin ka access band karne ka koi asli raasta
       tha hi nahi.

       Field na ho to 'active' maana jaata hai, isliye purane admin record
       waise ke waise chalte rahenge.

       Ek baat dhyan me rahe: apna hi status koi nahi badal sakta
       (`keepsOwnPrivileges()` use rokta hai). Isliye kisi admin ko block
       karna ya wapas chaalu karna sirf Firebase Console se hoga —
       jaan-boojh kar, taaki koi khud ko galti se band na kar le. */
    function isAdmin() {
      return hasUserDoc() && userDoc().role == 'admin' && isActive();
    }

    function isActive() {
      return hasUserDoc() && userDoc().get('status', 'active') == 'active';
    }

    function isStudent() {
      return hasUserDoc() && userDoc().role == 'student' && isActive();
    }

    /* The studentId the admin linked to this login. Empty until then. */
    function myStudentId() {
      return hasUserDoc() ? userDoc().get('studentId', '') : '';
    }

    function hasStudentId() {
      return isStudent() && myStudentId() != '';
    }

    /* The batch of the signed-in student — used by batch-wide notifications,
       live classes, recordings and assignments. */
    function myBatchId() {
      return exists(/databases/$(database)/documents/students/$(myStudentId()))
        ? get(/databases/$(database)/documents/students/$(myStudentId())).data.get('batchId', '')
        : '';
    }

    /* The course of the signed-in student — notes are shared per course. */
    function myCourseId() {
      return exists(/databases/$(database)/documents/students/$(myStudentId()))
        ? get(/databases/$(database)/documents/students/$(myStudentId())).data.get('courseId', '')
        : '';
    }

    /* --------------------------------------------------------------------
       "Abhi padh raha hai" — course chhod chuke student ko material nahi

       DO ALAG `status` THE AUR RULES SIRF EK KO DEKHTE THE.

         users/{uid}.status      'active' | 'blocked'   <- rules yahi dekhte the
         students/{sid}.status   'active' | 'completed' | 'dropped'

       Admin panel ka Status dropdown (js/dashboard/admin-students.js) DOOSRE
       wale par likhta hai, aur use koi rule padhta hi nahi tha. Nateeja: jo
       student course chhod chuka ho ya poora kar chuka ho, uska access app se
       band karne ka koi raasta hi nahi tha — wo apni batch ki nayi recording,
       naye notes aur naye assignments hamesha dekhta rehta. Band karne ka ek
       hi tarika bacha tha: Firebase Console kholkar `users` me haath se
       'blocked' likhna.

       Ab study material ke liye DONO dekhe jaate hain.

       Apna PURANA record — fees, receipt, haazri, certificate, apne sandesh —
       phir bhi khula rehta hai. Ye jaan-boojh kar hai: course poora karne wale
       ko apna certificate aur apni receipt hamesha milni chahiye, aur chhod
       chuke student ko bakaya bharne ka raasta bhi khula rehna chahiye.
       Isliye `ownsRow()` waise ka waisa hai; sirf `inMyBatch()` aur
       `inMyCourse()` par ye nayi shart lagi hai.

       Yahan koi extra document nahi padha ja raha — `students/{sid}` upar
       wale helpers pehle se hi padhte hain. */
    function studentStatus() {
      return exists(/databases/$(database)/documents/students/$(myStudentId()))
        ? get(/databases/$(database)/documents/students/$(myStudentId())).data.get('status', 'active')
        : '';
    }

    function isStudying() {
      return hasStudentId() && studentStatus() == 'active';
    }

    /* Sirf apne hi batch ki cheez. Khaali batch wale ko kuch nahi milta —
       warna jis document me galti se batchId khaali reh gaya ho wo har
       bina-batch wale student ko dikhne lagta. */
    function inMyBatch() {
      return isStudying() && myBatchId() != '' && resource.data.batchId == myBatchId();
    }

    function inMyCourse() {
      return isStudying() && myCourseId() != '' && resource.data.courseId == myCourseId();
    }

    /* Rows tagged with this student's id. Written as a plain field comparison
       (not .get()) so list queries filtered on studentId are allowed. */
    function ownsRow() {
      return hasStudentId() && resource.data.studentId == myStudentId();
    }

    /* Fields a user must never be able to set or change on themselves. */
    function keepsOwnPrivileges() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'status', 'studentId']);
    }

    /* A login may claim a Student ID ONLY if the student record the admin
       created carries the same email address. Without this, anyone could type
       someone else's Student ID and read their fees.
       Compared lower-cased on both sides: the admission form may have been
       filled in as "Soft@Gmail.com" while Firebase Auth stores the address
       lower-cased, and a case difference is not a different person. */
    /* Doosra raasta: admin ne khud us student ke record me is login ka `uid`
       likh diya ho. `student-data.js` ka fallback isi par chalta hai
       (where("uid","==",myUid)) aur `students` ka rule use pehle se maanta
       hai. Bina iske wo student `users` doc me apni Student ID kabhi jod hi
       nahi paata — aur ab jab study material apni hi batch/course tak simit
       hai, wo Student ID ke bina apni class, notes aur assignment kuch bhi
       nahi dekh paata. Ye branch admin ke apne haath se banaye rishte ko
       hi maanta hai, isliye email wali shart jitna hi pakka hai. */
    function mayClaimStudentId() {
      return request.resource.data.get('studentId', '') == ''
        || (
             exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
             && (
                  (request.auth.token.email != null
                   && get(/databases/$(database)/documents/students/$(request.resource.data.studentId))
                        .data.get('email', '').lower() == request.auth.token.email.lower())
                  || get(/databases/$(database)/documents/students/$(request.resource.data.studentId))
                       .data.get('uid', '') == request.auth.uid
                )
           );
    }

    /* ------------------------------------------------------------------ users */
    match /users/{uid} {
      allow get: if request.auth.uid == uid || isAdmin();
      allow list: if isAdmin();

      // Signup creates the caller's own profile — always as a plain student.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.get('status', 'active') == 'active'
        && mayClaimStudentId();

      allow update: if isAdmin()
        || (request.auth.uid == uid && keepsOwnPrivileges())
        // profile edit may attach a Student ID, same email check as signup
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentId'])
            && mayClaimStudentId());

      allow delete: if isAdmin();
    }

    /* ------------------------------------------------------------ admissions */
    // Anyone may submit the public admission form. Nobody but admin may read
    // them back — they hold phone numbers, addresses and documents.
    match /admissions/{appId} {
      /* `studentId` yahan se nahi aa sakta.

         Form ise likhta hi nahi — wo webhook ya admin ke approve karne par
         lagta hai. Par create har kisi ke liye khula hai, isliye console se
         banayi hui admission me kisi AUR ka studentId likha ja sakta tha.
         Uske baad us admission par payment link maangne par hisaab us doosre
         student ke record se hota tha — yaani kisi ka bhi bakaya padha ja
         sakta tha, aur paisa unke khaate me chadhaya ja sakta tha.

         Server par bhi ye khaai band ki gayi hai (createPaymentLink ab
         student ke record par ijaazat dobara jaanchta hai). Ye doosra
         taala hai — darwaze par hi.

         Fees (`courseFee`/`admissionFee`) yahan rok nahi sakte, kyunki form
         unhe khud likhta hai. Un par bharosa ab kahin kiya hi nahi jaata:
         rakam hamesha course ki list se aati hai. */
      allow create: if request.resource.data.get('status', '') == 'pending'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.mobile is string
        && request.resource.data.get('studentId', '') == '';
      allow read, update, delete: if isAdmin();
    }

    /* -------------------------------------------------------------- enquiries */
    match /enquiries/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.get('isRead', true) == false;
      allow read, update, delete: if isAdmin();
    }

    /* --------------------------------------------------------------- students */
    // js/dashboard/student-data.js reads the student's own record two ways:
    // by document id (= studentId) and, as a fallback, where("uid","==",myUid).
    match /students/{studentId} {
      allow get: if isAdmin()
        || (hasStudentId() && studentId == myStudentId())
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      // Aur teesra: signup/login ke baad app where("email","==",<apna email>)
      // chalata hai taaki Student ID khud jud jaaye — student ko yaad rakh kar
      // type na karni pade (SSZ2026ADC0004 vs SSZ2026ADCA0004 wali galti).
      // Sirf apna hi record mil sakta hai: email ki tulna request.auth.token
      // .email se hoti hai, jo login ka apna email hai aur badla nahi ja sakta.
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn() && request.auth.token.email != null
            && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    /* --------------------- rows a student may read about themselves ---------- */
    // Each of these is queried as where("studentId","==",myStudentId).
    match /fees/{id} {
      allow read: if isAdmin() || ownsRow();
      /* Student sirf apni ADHOORI (pending-verification) row me proof aur
         reference laga sakta hai — aur bas.

         PEHLE YAHAN EK BADI GALTI THI. Rok sirf NAYI status par thi
         (`!= 'paid'`), PURANI par nahi. Iska matlab tha ki student apni
         pehle se paid receipt ko bhi chhed sakta tha:

           * `status: 'failed'` kar deta -> wo payment aapki har report se
             gayab ho jaata (aaj ka collection, mahine ka collection, CSV —
             sab sirf 'paid' wali ginte hain)
           * `status: 'pending-verification'` kar deta -> wo dobara aapke
             verify wale khaane me aa jaata, aur confirm karte hi wahi paisa
             `paidFee` me DOOSRI baar jud jaata

         Ab dono taraf jaanch hai: row pehle se pending-verification honi
         chahiye, aur pending-verification hi rehni chahiye. Paid row ko
         student chhoo hi nahi sakta. */
      allow update: if isAdmin()
        || (ownsRow()
            && resource.data.get('status', '') == 'pending-verification'
            && request.resource.data.get('status', '') == 'pending-verification'
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['proofURL', 'txnRef', 'status', 'updatedAt']));

      // Proof upload karne ke liye student ko ek row chahiye jisme wo attach
      // ho — isliye wo khud ek khol sakta hai. Lekin sirf apne liye, sirf
      // unverified, aur amount 0 ke saath. `claimedAmount` sirf student ka
      // dawa hai ki usne kitna bheja; asli rakam admin verify karte waqt
      // bharta hai, isliye student apne aap paisa jama nahi dikha sakta.
      allow create: if isAdmin()
        || (hasStudentId()
            && request.resource.data.studentId == myStudentId()
            && request.resource.data.get('amount', -1) == 0
            && request.resource.data.get('status', '') == 'pending-verification'
            && request.resource.data.get('claimedAmount', 0) is number
            && request.resource.data.get('claimedAmount', 0) > 0);
      allow delete: if isAdmin();
    }

    /* Wo paise jo Razorpay se aaye par kisi record se jud nahi paaye — aksar
       tab jab link Razorpay dashboard se haath se banaya gaya ho. Webhook
       inhe yahan park karta hai, aur admin panel se aap sahi student se jodte
       hain.

       Likhna yahan kisi ke liye khula nahi hai — admin ke liye bhi nahi.
       Sirf Cloud Function likhta hai (Admin SDK rules ke upar se chalta hai),
       aur jodne ka kaam `attachPayment` karta hai jo khud admin ki jaanch
       karta hai. Panel ko sirf padhna hai. Rakam browser se kabhi nahi aati,
       isliye use badalne ka koi raasta hi nahi bachta. */
    match /unmatchedPayments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendance/{id} {
      allow read: if isAdmin() || ownsRow();
      allow write: if isAdmin();
    }

    match /submissions/{id} {
      allow read: if isAdmin() || ownsRow();
      /* Banate waqt student na apne marks likh sakta hai, na khud ko
         "graded" kar sakta hai.

         PEHLE YAHAN KISI FIELD PAR ROK NAHI THI. Sirf itna dekha jaata tha
         ki studentId apni ho. Isliye ek hi likhai me
         `{marks: 100, status: 'graded'}` bhej dena kaafi tha — aur aapke
         panel me wo bilkul asli graded submission jaisa dikhta. */
      allow create: if isAdmin()
        || (hasStudentId()
            && request.resource.data.studentId == myStudentId()
            && request.resource.data.get('marks', null) == null
            && request.resource.data.get('status', '') == 'submitted');
      // A submission may be edited until it has been marked.
      //
      // MCQ ke liye ek pakki shart aur: jawab (`answers`) ek baar likhne ke
      // baad kabhi badle nahi ja sakte. Isi wajah se student jawab dekh lene
      // ke baad apna paper sudhaar nahi sakta — marks bhale hi browser me
      // gine jaate hon, `answers` waise ke waise pade rehte hain aur admin
      // kabhi bhi unhe sahi jawab se milaakar dekh sakta hai.
      /* Student apne paper me marks ya "graded" KABHI nahi likh sakta.

         Pehle sirf itna tha ki `marks` abhi null ho — yaani PEHLI baar likhne
         par student khud ko 100 de sakta tha, aur panel me wo asli graded
         paper jaisa dikhta. Ab wo teeno field (`marks`, `status`, `gradedAt`,
         `autoGraded`) student ki taraf se badle hi nahi ja sakte; ye kaam
         `gradeMcq` Cloud Function karta hai, jo rules ke upar se chalta hai.

         Student ke liye bacha kya: apni file ya reference badalna, jab tak
         paper checked na ho. `answers` phir bhi patthar ki lakeer hain. */
      allow update: if isAdmin()
        || (ownsRow()
            && resource.data.get('marks', null) == null
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['marks', 'status', 'gradedAt', 'autoGraded', 'studentId', 'assignmentId'])
            && request.resource.data.get('answers', []) == resource.data.get('answers', []));
      allow delete: if isAdmin();
    }

    /* ------------------------- MCQ ke sahi jawab ---------------------------
       Ye jaan-boojh kar assignments se ALAG rakhe gaye hain. Agar sahi jawab
       assignment ke saath hote, to student browser ka console kholkar paper
       se pehle hi dekh leta — bilkul waisi hi dikkat jaisi study material ke
       public link me thi.

       Student ko ye tabhi milte hain jab uska submission ban chuka ho, aur
       submission ke `answers` upar wale rule se jam chuke hote hain. Yaani
       jawab dekhne ka ek hi raasta hai — pehle apna paper jama karo.
       ---------------------------------------------------------------------- */
    match /assignmentKeys/{assignmentId} {
      /* Ab student ise BILKUL nahi padh sakta — na paper dene se pehle, na
         baad me.

         Pehle "paper de chuke student" ko chhoot thi, taaki uska result dikh
         sake. Uske apne liye wo bekaar thi (jawab jam chuke hote hain), par
         usi key ko WhatsApp par bhej dena kaafi tha — aur jis dost ne abhi
         paper diya hi nahi tha, use saare jawab pehle se mil jaate.

         Ab result `gradeMcq` Cloud Function deta hai, aur sahi jawab usi ek
         jawab me lautate hain — sirf us student ko, sirf uska paper jama
         hone ke baad. Key khud yahan band hai. */
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ----------------------------------------------------------- certificates */
    /* Certificate ka record ab PUBLIC NAHI hai.

       Pehle yahan `allow get: if true` tha, is soch ke saath ki "number pata
       hona chahiye". Wo soch galat thi: certificate number ginti me chalta
       hai (SSZ/CERT/2026/0001, 0002 …), to koi bhi 1 se 500 tak ghumakar har
       certificate ka naam, course, grade aur percentage utha sakta tha.

       Ab public verification `certificateCodes/{verifyCode}` se hoti hai —
       wo code randomly banta hai, ginti me nahi. Dikhane laayak sab kuchh
       usi chhote document me rakha jaata hai, isliye visitor ko yahan aane
       ki zaroorat hi nahi padti. */
    match /certificates/{id} {
      allow get: if isAdmin() || ownsRow();
      allow list: if isAdmin() || ownsRow();
      allow write: if isAdmin();
    }

    // Tiny lookup doc: id = verifyCode, value = { certificateId }.
    // Knowing a code lets you resolve it; you cannot list them.
    match /certificateCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* ---------------------------------------------------------- notifications */
    // js/dashboard/student-data.js runs three separate queries, filtered on
    // `audience`. The rules mirror those filters exactly.
    match /notifications/{id} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.audience == 'all')
        /* Batch wale sandesh bhi ab sirf padh rahe student ko — warna course
           chhod chuke student ko "recording aa gayi" ka sandesh to jaata,
           par khol wo paata hi nahi. Apne naam wale sandesh (fees, receipt)
           neeche wali line se hamesha milte rehte hain. */
        || (isStudying() && resource.data.audience == 'batch'
            && resource.data.batchId == myBatchId())
        || (hasStudentId() && resource.data.audience == 'student'
            && resource.data.studentId == myStudentId());

      // "Padh liya" student ke dashboard se dabta hai, isliye use `readBy` me
      // sirf apna Student ID jodne ki ijaazat chahiye — aur bas itni hi.
      // Baaki koi field, aur kisi doosre ka ID, yahan se nahi badal sakta.
      //
      // `updatedAt` bhi list me hona ZAROORI hai: db-service.js ka update()
      // har patch ke saath serverTimestamp() jodta hai, isliye badle hue
      // field hamesha do hote hain. Sirf ['readBy'] likhne par har student ka
      // write chup-chaap reject ho jaata tha. (fees wale rule me ye pehle se
      // theek tha — wahin se ye tarika liya hai.)
      allow update: if isAdmin()
        || (hasStudentId()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['readBy', 'updatedAt'])
            && (request.resource.data.readBy ==
                  resource.data.get('readBy', []).concat([myStudentId()])
                || request.resource.data.readBy == resource.data.get('readBy', [])));
      allow create, delete: if isAdmin();
    }

    /* -------------- study material — sirf apne batch/course ka --------------

       PEHLE YAHAN TEENO PAR SIRF `isSignedIn()` THA, AUR WO BAHUT DHEELA THA.

       `isSignedIn()` ka matlab hai "koi bhi Firebase login". Yaani jisne abhi
       website par signup kiya ho — na koi student record, na batch, na ek
       rupaya fees — wo bhi:

         * har batch ki HAR live class padh sakta tha, jisme class ka join
           link aur `recordingURL` dono hote hain. Recording ka page batch
           dekhta tha, par rules nahi — aur asli pehra rules hi hain. Browser
           console se seedhe Firestore poochh lena kaafi tha.
         * har course ke saare notes ki list utha sakta tha (paid material).
         * doosre batch ke assignments padh sakta tha.

       Aur `isSignedIn()` `status` bhi nahi dekhta, isliye BLOCK kiya hua
       student bhi sab kuch padhta rehta tha.

       Ab teeno wahi shart lagate hain jo app pehle se query me lagata hai
       (js/dashboard/student-data.js):

         liveClasses  where("batchId",  "==", student.batchId)
         assignments  where("batchId",  "==", student.batchId)
         notes        where("courseId", "==", student.courseId)

       Rule aur query ka bilkul mel khaana zaroori hai — list query me
       Firestore document padhta nahi, sirf ye dekhta hai ki query kabhi
       aisa document laut hi na sake jise rule mana karta ho.

       `hasStudentId()` ke andar `isStudent()` hai aur usme `isActive()` —
       isliye block kiya hua login yahin ruk jaata hai.
       ---------------------------------------------------------------------- */
    match /liveClasses/{id} {
      allow get, list: if isAdmin() || inMyBatch();
      allow write: if isAdmin();
    }

    /* ---------------------- recording ka asli link -------------------------
       Ye class ke document se ALAG isliye rakha gaya hai.

       Rules poore document par lagte hain, kisi ek field par nahi. Isliye jab
       tak `recordingURL` class ke andar tha, "Sirf save karein" wala qadam
       sirf dikhawe ka tha: link save karte hi usi batch ka koi bhi student
       browser console se class ka document padh kar wo link nikaal sakta tha,
       chahe aapne "Students ko de dein" dabaya hi na ho. Adhoori recording,
       galat take, dobara record karni padi — sab wahin se nikal jaati.

       Ab link alag document me hai aur uspar `published` ki shart hai. Approve
       se pehle wo kisi student ko nahi milta.

       `list` sirf admin ke liye: student hamesha apni class ki id se ek hi
       document maangta hai, poori list kabhi nahi. */
    match /classRecordings/{classId} {
      allow get: if isAdmin()
        || (isStudying()
            && resource.data.get('published', false) == true
            && myBatchId() != ''
            && resource.data.get('batchId', '') == myBatchId());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /assignments/{id} {
      allow get, list: if isAdmin() || inMyBatch();
      allow write: if isAdmin();
    }

    match /notes/{id} {
      allow get, list: if isAdmin() || inMyCourse();
      // The download counter is bumped from the student dashboard.
      // `updatedAt` bhi chahiye — update() use hamesha jodta hai.
      // Ginti wahi badha sakta hai jo note padh bhi sakta hai.
      allow update: if isAdmin()
        || (inMyCourse() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['downloads', 'updatedAt']));
      allow create, delete: if isAdmin();
    }

    /* ------------------------- public website content ------------------------ */
    // Batches are read by the public admission form (batch picker).
    match /batches/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /faculty/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /faq/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Blog is queried as where("isPublished","==",true); admin sees drafts too.
    match /blog/{id} {
      // `get` may hit a doc with the field missing, so it needs the safe .get();
      // `list` must mirror the query filter exactly or Firestore refuses it.
      allow get:  if resource.data.get('isPublished', false) == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Reviews are queried as where("isApproved","==",true). A signed-in
    // student may submit one, but it stays hidden until admin approves it.
    match /reviews/{id} {
      allow get:  if resource.data.get('isApproved', false) == true || isAdmin();
      allow list: if resource.data.isApproved == true || isAdmin();
      allow create: if isStudent()
        && request.resource.data.get('isApproved', true) == false;
      allow update, delete: if isAdmin();
    }

    /* ------------------------------ ID counters ------------------------------ */
    // Application no / student ID / receipt no / certificate no are minted in a
    // transaction against counters/{name}. Names look like:
    //   admissions-2026 · students-2026-DCA · receipts-2026 · certificates-2026
    // A visitor submitting the admission form must be able to bump the
    // admissions counter — by exactly one, and only that counter.
    match /counters/{name} {
      // Bahar wale ko sirf admissions wala counter padhna hota hai (form
      // bharte waqt agla application number banane ke liye). Baaki counters
      // batate hain ki kitne students bhare, kitne receipt aur certificate
      // bane — ye kisi anjaan visitor ke kaam ki cheez nahi hai.
      allow read: if isAdmin() || name.matches('admissions-[0-9]{4}');
      allow create: if isAdmin()
        || (name.matches('admissions-[0-9]{4}')
            && request.resource.data.value is int
            && request.resource.data.value == 1);
      allow update: if isAdmin()
        || (name.matches('admissions-[0-9]{4}')
            && request.resource.data.value is int
            && request.resource.data.value == resource.data.value + 1);
      allow delete: if false;
    }

    /* --------------------------------- default -------------------------------- */
    // Anything not matched above is denied. Never remove this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
