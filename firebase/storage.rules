rules_version = '2';

/* ==========================================================================
   Soft Skill Zone Institute — Cloud Storage Security Rules
   --------------------------------------------------------------------------
   Publish: Firebase Console -> Storage -> Rules -> paste -> Publish
            (or `firebase deploy --only storage`)

   Folder map (js/core/constants.js -> STORAGE_PATHS)
     admissions/{appNo}/…      photo + documents from the public form
     students/{sid}/…          student documents
     assignments/{aid}/…       question papers uploaded by admin
     submissions/{aid}/{sid}/… student answer files
     notes/{courseId}/…        downloadable notes
     certificates/…            generated certificate PDFs
     fees/proofs/{sid}/…       payment screenshots
     public/…                  gallery, faculty photos, blog covers
   ========================================================================== */

service firebase.storage {
  match /b/{bucket}/o {

    /* ---------------------------------------------------------------- helpers */
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasUserDoc() && role() == 'admin';
    }

    /* Guarded: firestore.get() on a missing document throws and denies the
       whole rule, so every caller checks hasUserDoc() first. */
    function hasUserDoc() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function myStudentId() {
      return hasUserDoc()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
            .data.get('studentId', '')
        : '';
    }

    /* A student's own folder — empty studentId must never match an empty path. */
    function ownsFolder(sid) {
      return hasUserDoc() && myStudentId() != '' && sid == myStudentId();
    }

    // 5 MB ceiling; the app already compresses photos client-side.
    function sizeOk() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return isImage()
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('application/vnd.*')
        || request.resource.contentType == 'application/msword';
    }

    /* Application number ka shakl — SSZ-APP-2026-0001. Iske bina koi bhi
       admissions/ ke neeche apni marzi ka folder bana sakta tha.
       matches() poori string par lagta hai. */
    function looksLikeAppNo(appNo) {
      return appNo.matches('^SSZ-APP-20[0-9][0-9]-[0-9]{4}$');
    }

    /* Bina account wale visitor ke liye: sirf nayi file ban sakti hai.
       resource == null ka matlab — us path par abhi kuchh rakha nahi hai.
       Yahi wo taala hai jo kisi doosre applicant ki photo ya marksheet ke
       upar file chadhane (ya use mitane) se rokta hai. safeFileName() har
       naam me timestamp + random jodta hai, isliye asli form kabhi ek hi
       path par do baar nahi likhta — ye rok sahi submission ko nahi todegi. */
    function newAnonUpload(appNo) {
      return request.resource != null
        && resource == null
        && looksLikeAppNo(appNo)
        && sizeOk();
    }

    /* ---------------------------------------------------- public admission form */
    /* Admin ki taraf pehle: poore admissions/ par padhna, list dekhna,
       badalna aur mitana — sab. (Reject hone par folder saaf karna isi se
       chalta hai.) */
    match /admissions/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    /* Ab bina account wale visitor ki taraf. Use apni photo aur documents
       upload karne dene hi padenge — par sirf itna hi:
         - sirf do jagah: admissions/{appNo}/photo.jpg aur .../docs/{file}
         - sirf nayi file (kisi purani file ke upar likhna aur mitana band)
         - appNo asli shakl ka ho
       Padhne aur list dekhne ki ijazat yahan bilkul nahi hai — wo upar wale
       admin rule se hi milti hai.

       Purana rule ek hi tha — `{allPaths=**}` — aur usme resource ki jaanch
       nahi thi: koi bhi anjaan aadmi kisi bhi applicant ki photo ya marksheet
       ke upar apni file chadha sakta tha, aur admissions/ ke neeche kahin bhi
       jitni chahe folder-parat bana sakta tha. */
    match /admissions/{appNo}/{file} {
      allow write: if file == 'photo.jpg' && newAnonUpload(appNo) && isImage();
    }

    match /admissions/{appNo}/docs/{file} {
      allow write: if newAnonUpload(appNo) && isDocument();
    }

    /* ------------------------------------------------------- student documents */
    match /students/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin();
    }

    /* ------------------------------------------------------------ submissions */
    match /submissions/{aid}/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin()
        || (ownsFolder(sid) && isDocument() && sizeOk());
    }

    /* ------------------------------------------------------------ fee proofs */
    match /fees/proofs/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin()
        || (ownsFolder(sid) && isImage() && sizeOk());
    }

    /* --------------------------------- study material (signed-in students) --- */
    match /notes/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /assignments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /certificates/{allPaths=**} {
      // Certificates are shared by link (employers verify them), so reading a
      // known URL is public; only admin can create or replace one.
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ------------------------------------------------ public website images --- */
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && sizeOk();
    }

    /* --------------------------------------------------------------- default -- */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
