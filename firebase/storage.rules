rules_version = '2';

/* ==========================================================================
   Soft Skill Zone Institute — Cloud Storage Security Rules
   --------------------------------------------------------------------------
   Publish: Firebase Console -> Storage -> Rules -> paste -> Publish
            (or `firebase deploy --only storage`)

   Folder map (js/core/constants.js -> STORAGE_PATHS)
     admissions/{appNo}/…      photo + documents from the public form
     students/{sid}/…          student documents
     assignments/{aid}/…       question papers uploaded by admin
     submissions/{aid}/{sid}/… student answer files
     notes/{courseId}/…        downloadable notes
     certificates/…            generated certificate PDFs
     fees/proofs/{sid}/…       payment screenshots
     public/…                  gallery, faculty photos, blog covers
   ========================================================================== */

service firebase.storage {
  match /b/{bucket}/o {

    /* ---------------------------------------------------------------- helpers */
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    /* Wahi jaanch jo firestore.rules me hai — block kiya hua admin account
       yahan bhi kuch nahi kar sakta. `status` usi document me hai jo `role`
       batata hai, isliye ek bhi extra Firestore read nahi lagta. */
    function isAdmin() {
      return hasUserDoc() && role() == 'admin' && userStatus() == 'active';
    }

    function userStatus() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
        .data.get('status', 'active');
    }

    /* Guarded: firestore.get() on a missing document throws and denies the
       whole rule, so every caller checks hasUserDoc() first. */
    function hasUserDoc() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function myStudentId() {
      return hasUserDoc()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
            .data.get('studentId', '')
        : '';
    }

    /* A student's own folder — empty studentId must never match an empty path. */
    function ownsFolder(sid) {
      return hasUserDoc() && myStudentId() != '' && sid == myStudentId();
    }

    /* Student ka apna course aur batch — Firestore se, wahi jagah jahan se
       Firestore ke rules bhi padhte hain. `exists()` pehle isliye ki gayab
       document par `get()` poore rule ko gira deta hai. */
    function myStudentDoc() {
      return firestore.get(/databases/(default)/documents/students/$(myStudentId())).data;
    }

    function hasStudentDoc() {
      return myStudentId() != ''
        && firestore.exists(/databases/(default)/documents/students/$(myStudentId()));
    }

    /* Ye course/batch us student ka hai ya nahi. Khaali kabhi match nahi
       karta, warna jis record me course/batch bhara hi na ho wo har aise
       student ko khul jaata. */
    /* `status` bhi wahi document batata hai jo course batata hai, isliye ye
       shart muft me lag jaati hai — ek bhi extra Firestore read nahi.
       Course chhod chuke ya poora kar chuke student ki file ab nahi khulti;
       uska apna record (fees, certificate) waise hi khula rehta hai. */
    function isStudying() {
      return hasStudentDoc() && myStudentDoc().get('status', 'active') == 'active';
    }

    function myCourse(courseId) {
      return isStudying() && courseId != ''
        && myStudentDoc().get('courseId', '') == courseId;
    }

    /* Ek juda hua, chalu student — yaani jiska login admin ke banaye student
       record se juda hai.

       Ye `isSignedIn()` se bahut sakht hai (naya-naya signup kiya account,
       ya bina record wala login, yahan ruk jaata hai) par batch tak simit
       nahi hai. Wajah ek hi hai, aur wo bandish Firebase ki apni hai:

         Storage ke rule me EK request par SIRF DO Firestore document
         padhe ja sakte hain. Teesra chhoote hi Firebase khud mana kar
         deta hai.

       Assignment ka folder uske apne id se banta hai (assignments/{aid}/…),
       isliye batch jaanchne ke liye teen document chahiye hote: users,
       students, aur assignments — ek zyada. Notes ka folder courseId se
       banta hai, isliye wahan do me hi kaam ho jaata hai aur wo poori tarah
       course tak simit hai.

       Assignment ki file ko batch tak simit karne ka saaf raasta ye hai ki
       folder me hi batch aa jaye (assignments/{batchId}/{aid}/…). Wo path
       badalne wala kaam hai aur purani files ko hilana padega, isliye alag
       se karna behtar hai. */
    function isLinkedStudent() {
      return isStudying();
    }

    // 5 MB ceiling; the app already compresses photos client-side.
    function sizeOk() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return isImage()
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('application/vnd.*')
        || request.resource.contentType == 'application/msword';
    }

    /* Application number ka shakl — SSZ-APP-2026-0001. Iske bina koi bhi
       admissions/ ke neeche apni marzi ka folder bana sakta tha.
       matches() poori string par lagta hai. */
    function looksLikeAppNo(appNo) {
      return appNo.matches('^SSZ-APP-20[0-9][0-9]-[0-9]{4}$');
    }

    /* Bina account wale visitor ke liye: sirf nayi file ban sakti hai.
       resource == null ka matlab — us path par abhi kuchh rakha nahi hai.
       Yahi wo taala hai jo kisi doosre applicant ki photo ya marksheet ke
       upar file chadhane (ya use mitane) se rokta hai. safeFileName() har
       naam me timestamp + random jodta hai, isliye asli form kabhi ek hi
       path par do baar nahi likhta — ye rok sahi submission ko nahi todegi. */
    function newAnonUpload(appNo) {
      return request.resource != null
        && resource == null
        && looksLikeAppNo(appNo)
        && sizeOk();
    }

    /* ---------------------------------------------------- public admission form */
    /* Admin ki taraf pehle: poore admissions/ par padhna, list dekhna,
       badalna aur mitana — sab. (Reject hone par folder saaf karna isi se
       chalta hai.) */
    match /admissions/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    /* Ab bina account wale visitor ki taraf. Use apni photo aur documents
       upload karne dene hi padenge — par sirf itna hi:
         - sirf do jagah: admissions/{appNo}/photo.jpg aur .../docs/{file}
         - sirf nayi file (kisi purani file ke upar likhna aur mitana band)
         - appNo asli shakl ka ho
       Padhne aur list dekhne ki ijazat yahan bilkul nahi hai — wo upar wale
       admin rule se hi milti hai.

       Purana rule ek hi tha — `{allPaths=**}` — aur usme resource ki jaanch
       nahi thi: koi bhi anjaan aadmi kisi bhi applicant ki photo ya marksheet
       ke upar apni file chadha sakta tha, aur admissions/ ke neeche kahin bhi
       jitni chahe folder-parat bana sakta tha. */
    match /admissions/{appNo}/{file} {
      allow write: if file == 'photo.jpg' && newAnonUpload(appNo) && isImage();
    }

    match /admissions/{appNo}/docs/{file} {
      allow write: if newAnonUpload(appNo) && isDocument();
    }

    /* ------------------------------------------------------- student documents */
    match /students/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin();
    }

    /* ------------------------------------------------------------ submissions */
    match /submissions/{aid}/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin()
        || (ownsFolder(sid) && isDocument() && sizeOk());
    }

    /* ------------------------------------------------------------ fee proofs */
    match /fees/proofs/{sid}/{allPaths=**} {
      allow read: if isAdmin() || ownsFolder(sid);
      allow write: if isAdmin()
        || (ownsFolder(sid) && isImage() && sizeOk());
    }

    /* ------------------- study material — apne hi course/batch ka -----------

       PEHLE DONO PAR SIRF `isSignedIn()` THA.

       Firestore me notes ka record ab sirf apne course ka khulta hai, par
       ASLI FILE yahan padi hai — aur yahan koi bhi Firebase login use padh
       sakta tha. Storage me `read` ke andar `list` bhi aata hai, isliye ek
       naya account `notes/` par listAll() chalakar har course ka folder aur
       har file ka naam nikaal sakta tha, phir ek-ek karke download kar leta.
       Jitna paid material hai, sab.

       Isi wajah se `admin-materials.js` file ka URL nahi, `filePath` rakhta
       hai — taaki link dene se pehle Storage khud padhne wale ko jaanche.
       Wo poori soch in do rules ki wajah se bekaar thi.

       Ab notes folder ke naam (courseId) se jaanche jaate hain. Assignments
       par kam se kam itni shart lag gayi hai ki login kisi asli student ke
       record se juda ho — poora kyun nahi, wo `isLinkedStudent()` ke upar
       likha hai.
       ---------------------------------------------------------------------- */
    match /notes/{courseId}/{allPaths=**} {
      allow read: if isAdmin() || myCourse(courseId);
      allow write: if isAdmin();
    }

    match /assignments/{aid}/{allPaths=**} {
      allow read: if isAdmin() || isLinkedStudent();
      allow write: if isAdmin();
    }

    match /certificates/{allPaths=**} {
      // Certificates are shared by link (employers verify them), so reading a
      // known URL is public; only admin can create or replace one.
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ------------------------------------------------ public website images --- */
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && sizeOk();
    }

    /* --------------------------------------------------------------- default -- */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
